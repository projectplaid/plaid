# direnv runs this from the repo root, so $PWD is the absolute repo path.

export L4RE_SRCDIR="$PWD/third_party/sources/l4"
export L4RE_OBJDIR="$PWD/build/l4re/x86_64"

export KERNEL_SRCDIR="$PWD/third_party/sources/fiasco"
export KERNEL_OBJDIR="$PWD/build/fiasco/x86_64"

# voc built from the tree (INSTALLDIR=$VOC_ROOT/install make); ahead of any
# system-wide voc on PATH.
export VOC_ROOT="$PWD/third_party/sources/voc"
PATH_add "$VOC_ROOT/install/bin"
